# ============================================================
# Data privat & rahasia — JANGAN PERNAH di-commit
# ============================================================
# Token bot Telegram & konfigurasi rahasia lain (dipakai via --dart-define-from-file)
secrets.json
secrets.*.json
!secrets.example.json
*.env
.env*

# Kunci penandatanganan APK (keystore)
*.jks
*.keystore
key.properties
android/key.properties

# Konfigurasi layanan cloud (jika nanti memakai Firebase/Supabase)
google-services.json
GoogleService-Info.plist
firebase_options.dart

# File backup & data apotek (data produk, transaksi, pelanggan)
*.posbackup
backups/
*.db
*.sqlite
*.sqlite3

# File impor/ekspor data asli (gunakan folder sample_data/ untuk contoh dummy)
*.xlsx
*.xls
*.csv
!sample_data/**

# Hasil build APK / bundle
*.apk
*.aab

# Pengaturan lokal Claude Code / editor
.claude/settings.local.json
